# Las librerías del panel solo se cargan desde api.php, index.php y
# sendmail.php mediante require. No hay motivo para que respondan a una
# petición por HTTP: bloquearlas reduce la superficie expuesta.
#
# Esto no afecta a los require de PHP, que van por el sistema de archivos y
# no pasan por las reglas del servidor web.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
