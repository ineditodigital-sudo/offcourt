# Credenciales del despliegue por FTP (las lee deploy.cjs).
# Copia este archivo como `.env` y rellena los valores reales.
# `.env` está en .gitignore: nunca debe subirse al repositorio.

FTP_HOST=ftp.tudominio.com
FTP_USER=usuario
FTP_PASSWORD=contraseña
FTP_REMOTE_DIR=/public_html
SITE_URL=https://offcourtsports.com.mx
